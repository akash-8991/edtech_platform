# Staging: cheap and disposable. Copy to staging.tfvars, fill in, then:  terraform apply -var-file=environments/staging.tfvars
environment        = "staging"
domain_name        = "learn-staging.institute.edu"
hosted_zone_id     = "" # or the Route 53 zone id
alarm_email        = "platform-oncall@institute.edu"
single_nat_gateway = true
db_instance_class  = "db.t4g.medium"
db_allocated_storage = 50
redis_node_type    = "cache.t4g.micro"
api_min_tasks      = 1
api_max_tasks      = 3
worker_cpu         = 1024
worker_memory      = 2048
enable_waf         = true
enable_grader      = false
push_mode          = "off"
image_tag          = "bootstrap"
extra_cors_origins = ["capacitor://localhost", "https://localhost"] # the native apps
