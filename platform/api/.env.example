DATABASE_URL=postgresql://edtech:edtech@localhost:5433/edtech
JWT_SECRET=change-me-dev-only
# HMAC secret shared with the admissions front (server-to-server, IAM-001)
ADMISSIONS_HMAC_SECRET=change-me-dev-only
SEGREGATION_OF_DUTIES=true

# --- Phase 3: AI (provider-neutral gateway; routes try Anthropic first, then OpenRouter) ---
ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-opus-5-5
OPENROUTER_API_KEY=
# OpenRouter model slug for the fallback route (deployment config; no default is assumed)
OPENROUTER_MODEL=
# Extra "provider:model" entries allowed in AI_ROUTES_JSON overrides (default routes are always allowed)
AI_MODEL_ALLOWLIST=
AI_RATE_PER_HOUR=200
AI_WORKER=1
AI_WORKER_CONCURRENCY=3
# Kill switch also available at runtime: PUT /v1/admin/config/ai.kill_switch

# --- Phase 4: tutor retrieval (optional; without it the tutor uses lexical retrieval only) ---
OPENROUTER_EMBED_MODEL=

# --- Phase 5: grading ---
# Untrusted learner code is NEVER run in the API process. Set docker to enable the container sandbox (needs a running Docker daemon + image).
SANDBOX_MODE=disabled
SANDBOX_IMAGE_PYTHON=python:3.12-alpine

# --- Phase 6: labs, exams, proctoring ---
# Proctoring provider (generic REST adapter; see docs/proctor-provider-contract.md). Unset => in-process MOCK provider (dev only).
PROCTOR_BASE_URL=
PROCTOR_API_KEY=
# Shared secret the provider uses to sign webhooks to POST /v1/proctoring/webhook
PROCTOR_WEBHOOK_SECRET=
EXAM_RECEIPT_SECRET=
LAB_QR_SECRET=

# --- Phase 7: security, privacy, operations (see docs/ops and docs/security) ---
# Production REFUSES to start unless these are real values (src/platform/config-guard.ts):
#   JWT_SECRET ADMISSIONS_HMAC_SECRET MEDIA_TOKEN_SECRET EXAM_RECEIPT_SECRET LAB_QR_SECRET METRICS_TOKEN  (>=32 chars; METRICS_TOKEN >=24)
#   DATA_ENC_KEY OFFLINE_MASTER_KEY  (64 hex chars each; KMS-managed)   CORS_ORIGINS (comma list) or CORS_NONE=1
DATA_ENC_KEY=
METRICS_TOKEN=
CORS_ORIGINS=
TRUST_PROXY=1                 # number of reverse-proxy hops to trust for client IPs (never "true")
# Defaults: ON in production, OFF elsewhere (tests turn them on explicitly). MFA_ENFORCE=0 / RATE_LIMIT_DISABLED=1 are rejected in production.
MFA_ENFORCE=
PRIVACY_ENFORCE_CONSENT=
ACCESSIBILITY_ENFORCE=
RL_IP_PER_MIN=3000            # per instance; divide by instance count or use a shared store
RL_ACTOR_PER_MIN=1200
RL_LOGIN_PER_MIN=20
HASH_CONCURRENCY=4            # concurrent password hashes
UV_THREADPOOL_SIZE=8
SESSION_CACHE_MS=5000         # fallback bound; with REDIS_URL revocation is pushed immediately         # max delay for a revoked session to stop working on any instance
STRUCT_CACHE_MS=600000
JSON_BODY_LIMIT=2mb
LOG_JSON=1
REQUEST_LOG=
# OIDC single sign-on (optional)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_MFA_AMR=mfa,otp,hwk

# --- production hardening (required in production, see docs/ops/scaling.md) ---
REDIS_URL=redis://localhost:6379
PROCESS_ROLE=all              # api | worker | all (production: api and worker as separate deployments)
STORAGE_DRIVER=local          # s3 in production
S3_BUCKET=
S3_REGION=ap-south-1
S3_KMS_KEY_ID=
S3_ENDPOINT=                  # only for MinIO / S3-compatible stores
SCANNER=noop                  # clamav in production
CLAMD_HOST=
CLAMD_PORT=3310
SCAN_MAX_BYTES=26214400
SECRETS_MANAGER_SECRET_ID=    # JSON object of env vars loaded before startup (vault wins over env)
# Rotation overlap (see docs/security/key-rotation.md)
JWT_SECRET_PREVIOUS=
DATA_ENC_KEY_PREVIOUS=
OFFLINE_MASTER_KEY_PREVIOUS=
MEDIA_TOKEN_SECRET_PREVIOUS=
LAB_QR_SECRET_PREVIOUS=
# Database scaling
DB_CONNECTION_LIMIT=
DB_POOL_TIMEOUT=
DB_PGBOUNCER=0                # 1 when DATABASE_URL points at PgBouncer (transaction mode)
DATABASE_REPLICA_URL=         # optional read replica for reports
INTEGRITY_CHECK_HOURS=6
IDEMPOTENCY_TTL_HOURS=24
INTAKE_MAX_BATCH=1000
REPORT_CSV_MAX_ROWS=100000
