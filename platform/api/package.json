{
  "name": "edtech-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "dev": "ts-node src/main.ts",
    "test": "jest",
    "prisma:gen": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "ai:smoke": "ts-node scripts/ai-smoke.ts",
    "inventory": "ts-node scripts/gen-inventory.ts",
    "loadtest": "ts-node scripts/loadtest.ts",
    "lint:migrations": "ts-node scripts/migration-lint.ts",
    "rotate-keys": "ts-node scripts/rotate-keys.ts",
    "start:worker": "node dist/src/worker.js",
    "test:cov": "jest --coverage && ts-node scripts/coverage-report.ts",
    "user:create": "ts-node scripts/create-user.ts",
    "walkthrough": "bash scripts/walkthrough.sh",
    "contracts:infer": "ts-node scripts/infer-contracts.ts",
    "openapi": "ts-node scripts/gen-openapi.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "maxWorkers": 1,
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.spec.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text-summary",
      "json-summary",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 77,
        "functions": 90,
        "lines": 96
      },
      "./src/domain/": {
        "statements": 95,
        "branches": 90,
        "functions": 98
      },
      "./src/security/": {
        "statements": 94,
        "branches": 88,
        "functions": 92
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/client-secrets-manager": "^3.1145.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3",
    "ioredis": "^6.0.0",
    "jose": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jest": "^30.5.2",
    "js-yaml": "^5.4.2",
    "prisma": "^6.19.3",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
