{
  "name": "edtech-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Android and iOS app: the learner web app in a native shell (Capacitor) with native push notifications",
  "scripts": {
    "build:web": "cd ../web && npm run build",
    "sync": "npm run build:web && cap sync",
    "doctor": "cap doctor",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "npm run sync && cap run android",
    "run:ios": "npm run sync && cap run ios"
  },
  "dependencies": {
    "@capacitor-firebase/messaging": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "firebase": "^11.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "typescript": "~5.6.3"
  }
}
