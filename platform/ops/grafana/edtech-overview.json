{
 "title": "EdTech Platform - overview",
 "uid": "edtech-overview",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "DS",
    "type": "datasource",
    "query": "prometheus",
    "label": "Data source"
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Request rate by status",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(http_requests_total{job=\"edtech-api\"}[5m]))",
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "5xx ratio",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_requests_total{job=\"edtech-api\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{job=\"edtech-api\"}[5m]))",
     "legendFormat": "5xx"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "API latency p50/p95/p99",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"edtech-api\"}[5m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Event-loop lag p99",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "nodejs_eventloop_lag_p99_seconds",
     "legendFormat": "{{job}}"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "External calls by outcome",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service, outcome) (rate(external_calls_total[5m]))",
     "legendFormat": "{{service}} {{outcome}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "External call latency p95",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(external_call_duration_seconds_bucket[5m])))",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Job queue depth",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (jobs_queue_depth)",
     "legendFormat": "{{kind}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Grading backlog",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(grading_pending_submissions)",
     "legendFormat": "pending"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Exam attempts in progress",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(exam_attempts_in_progress)",
     "legendFormat": "in progress"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Open exam incidents",
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (severity) (exam_incidents_open)",
     "legendFormat": "{{severity}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "AI spend today vs cap",
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(ai_cost_usd_today)",
     "legendFormat": "spend"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Auth failures and rate limiting",
   "gridPos": {
    "x": 12,
    "y": 40,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(auth_failures_total[5m]))",
     "legendFormat": "auth failures"
    }
   ]
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Rate-limit rejections",
   "gridPos": {
    "x": 0,
    "y": 48,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (scope) (rate(rate_limited_total[5m]))",
     "legendFormat": "{{scope}}"
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Redis fallback / errors",
   "gridPos": {
    "x": 12,
    "y": 48,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(redis_fallback_total[5m])) + sum(rate(redis_errors_total[5m]))",
     "legendFormat": "fallback+errors"
    }
   ]
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Idempotent replays",
   "gridPos": {
    "x": 0,
    "y": 56,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(idempotent_replays_total[5m]))",
     "legendFormat": "replays"
    }
   ]
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "Integrity check (1 = ok)",
   "gridPos": {
    "x": 12,
    "y": 56,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS}"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "min(integrity_ok)",
     "legendFormat": "ok"
    }
   ]
  }
 ]
}